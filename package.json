{
  "name": "drawio-ai-kit",
  "version": "2.0.0",
  "description": "A kit that helps an AI draw beautiful, correct draw.io diagrams: ground-truth AWS/Azure/GCP stencil catalogs, layout principles, and a validator. Exposed via the zero-dependency drawio-ai CLI.",
  "type": "module",
  "bin": {
    "drawio-ai": "./dist/cli.mjs"
  },
  "scripts": {
    "cli": "node src/cli.mjs",
    "build": "bun scripts/build.mjs",
    "build:check": "bun scripts/build.mjs --check",
    "build:analyze": "bun scripts/build.mjs --analyze",
    "test": "node --test",
    "test:bun": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "gen:catalog": "python3.11 scripts/ingest_index.py"
  },
  "files": [
    "dist",
    "catalog",
    "data/lobe-icons.json",
    "vendor",
    "examples",
    "skills",
    "README.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "exports": {
    ".": "./dist/kit.mjs"
  }
}
