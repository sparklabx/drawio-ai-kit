{
  "name": "drawio-ai-kit",
  "version": "3.0.0",
  "description": "Helps an AI draw correct, beautiful draw.io diagrams: ground-truth AWS/Azure/GCP/OSS icon catalogs, a declarative layout engine, a validator, and one agent skill. drawio-ai CLI with no runtime dependencies (bundled).",
  "keywords": [
    "drawio",
    "draw.io",
    "diagram",
    "architecture-diagram",
    "aws",
    "azure",
    "gcp",
    "bpmn",
    "ai",
    "agent-skill",
    "claude"
  ],
  "homepage": "https://github.com/sparklabx/drawio-ai-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparklabx/drawio-ai-kit.git"
  },
  "bugs": {
    "url": "https://github.com/sparklabx/drawio-ai-kit/issues"
  },
  "type": "module",
  "bin": {
    "drawio-ai": "dist/cli.mjs"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "build": "bun scripts/build.mjs",
    "build:check": "bun scripts/build.mjs --check",
    "build:analyze": "bun scripts/build.mjs --analyze",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\" \"bench/**/*.test.ts\"",
    "test:bun": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "gen:catalog": "python3.11 scripts/ingest_index.py"
  },
  "files": [
    "dist",
    "catalog",
    "data/lobe-icons.json",
    "data/catalog-index.json",
    "data/aliases.json",
    "vendor",
    "examples",
    "skills",
    "README.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/kit.d.ts",
      "default": "./dist/kit.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "minisearch": "^7.2.0",
    "typescript": "^7.0.2"
  }
}
